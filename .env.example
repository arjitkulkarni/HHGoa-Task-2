# Speech-to-text (required for voice input). Get one at https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional. Enables the "grounded rewrite" answer path (an LLM re-voices the
# extractive answer using ONLY the retrieved spans). The pipeline is fully
# functional without it — this path is off the measured latency budget by design.
ANTHROPIC_API_KEY=

# Server
PORT=8080
HOST=0.0.0.0
